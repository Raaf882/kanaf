{
    "version": 2,
    "framework": null,
    "outputDirectory": "dist",
    "installCommand": "composer install --no-dev --optimize-autoloader --no-interaction && npm ci",
    "buildCommand": "npm run build",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.2"
        }
    },
    "routes": [
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_NAME": "Kanaf",
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_KEY": "base64:ttQWWMbQV4nwd0tJFvJqObc98EAUYv/1YKeUoMXW4w0=",
        "APP_URL": "https://kanaf.vercel.app",
        "DB_CONNECTION": "sqlite",
        "SESSION_DRIVER": "cookie",
        "SESSION_ENCRYPT": "true",
        "CACHE_STORE": "array",
        "QUEUE_CONNECTION": "sync",
        "LOG_CHANNEL": "stderr"
    }
}
